<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>WebRTC Video Conferencing</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.5/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    
    .video-container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      height: calc(100vh - 150px);
      background-color: #f8f9fa;
    }
    .video-container video {
      width: 100%;
      max-width: 100%;
      margin: 10px;
      border-radius: 10px;
      object-fit: cover;
      background: #000;
    }
    @media (max-width: 768px) {
      .video-container {
        flex-direction: column;
      }
    }
    .controls {
      background-color: #f8f9fa;
      padding: 10px;
      border-top: 1px solid #ddd;
    }
    .controls .input-group {
      margin-top: 10px;
    }
    .btn-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 45px;
      height: 45px;
      border-radius: 50%;
    }
    .video-container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      height: calc(100vh - 150px);
      background-color: #f8f9fa;
    }

    .video-container video {
      width: 100%;
      max-width: 100%;
      margin: 10px;
      border-radius: 10px;
      object-fit: cover;
      background: #000;
    }

    @media (max-width: 768px) {
      .video-container {
        flex-direction: column;
      }
    }

    .controls {
      background-color: #f8f9fa;
      padding: 15px;
      border-top: 1px solid #ddd;
      text-align: center;
    }

    .controls .btn-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 60px;
      height: 60px;
      margin: 0 5px;
      border-radius: 50%;
      font-size: 1.5rem;
    }

    .controls .btn-icon.active {
      background-color: #ff4d4d !important; /* Red for active buttons */
      color: #fff;
    }

    .btn-icon .bi {
      transition: transform 0.3s, color 0.3s;
    }

    .btn-icon.active .bi {
      transform: scale(1.1); /* Slightly enlarges active icons */
    }
  </style>
</head>
<body>
  <div id="login" class="vh-100 d-flex justify-content-center align-items-center">
    <div class="text-center">
      <h2>Login</h2>
      <input type="text" id="username" class="form-control my-3" placeholder="Enter your name">
      <button id="loginBtn" class="btn btn-primary">Login</button>
    </div>
  </div>

  <div id="main" hidden class="d-flex flex-column vh-100">
    <div class="container-fluid video-container" id="videoContainer">
      <!-- Video blocks will be added dynamically here -->
    </div>

    <div class="controls  w-100">
      <div class="container">
        <div class="input-group mt-2">
          <input type="text" id="peerName" class="form-control" placeholder="Type a message">
          <button id="startCallBtn" class="btn btn-success">Call</button>
        </div>
        <div class="row align-items-center gy-2">
          <div class="controls">
            <button id="toggleMic" class="btn btn-icon btn-secondary" title="Mute/Unmute Mic">
              <i class="bi bi-mic"></i>
            </button>
            <button id="toggleCam" class="btn btn-icon btn-secondary" title="Turn Camera On/Off">
              <i class="bi bi-camera-video"></i>
            </button>
            <button id="screenShareBtn" class="btn btn-icon btn-secondary" title="Share Screen">
              <i class="bi bi-display"></i>
            </button>
            <button id="disconnectBtn" class="btn btn-icon btn-danger" title="Disconnect">
              <i class="bi bi-x-circle"></i>
            </button>
          </div>
          <div class="col-12">
            <div id="chat" class="border rounded p-3 bg-white">
              <div id="messages" class="overflow-auto" style="max-height: 150px;"></div>
              <div class="input-group mt-2">
                <input type="text" id="messageInput" class="form-control" placeholder="Type a message">
                <button id="sendBtn" class="btn btn-primary">
                  <i class="bi bi-send"></i>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/js/client.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

  <script>
    
  </script>
</body>
</html>
